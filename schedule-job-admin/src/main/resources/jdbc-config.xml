<?xml version="1.0" encoding="UTF-8"?>
<jdbc-config>
    <db-info>
        <driver-class>com.mysql.cj.jdbc.Driver</driver-class>
        <url>jdbc:mysql://localhost:3306/sys?useSSL=false&amp;serverTimezone=UTC</url>
        <username>root</username>
        <password></password>
        <!-- 可选连接参数（简化版可省略，这里仅示例） -->
        <maxActive>10</maxActive>
        <maxWait>60000</maxWait>
    </db-info>
    <pool-config>
        <max-pool-size>10</max-pool-size> <!-- 最大连接数 -->
        <min-idle>2</min-idle>             <!-- 最小空闲连接 -->
        <max-wait>30000</max-wait>          <!-- 获取连接超时时间（ms） -->
    </pool-config>
</jdbc-config>